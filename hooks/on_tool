#!/usr/bin/env nu

use std/log

# Check a tool call before the agent runs it
def main [
    agent: string # Agent requesting the tool call.
]: nothing -> nothing {
    if (which agent-tool-check | is-empty) {
        log error "Missing required tool: agent-tool-check. Install it and make sure it is on PATH."
        exit 1
    }
    exec agent-tool-check $agent
}
