#!/usr/bin/env nu

use std/log

def focused-client [pane: string]: string -> bool {
    lines
    | parse '{pane} {flags}'
    | any {|client| $client.pane == $pane and ('focused' in ($client.flags | split row ',')) }
}

def pane-focused []: nothing -> bool {
    if 'TMUX_PANE' not-in $env { return false }
    let clients = ^tmux list-clients -F '#{pane_id} #{client_flags}'
    $clients | focused-client $env.TMUX_PANE
}

def notify-ntfy [title: string, message: string]: nothing -> record {
    let url = $"https://ntfy.sh/($env.NTFY_CHANNEL_DESKTOP)"
    let response = (http post
        --full
        --allow-errors
        --headers {Title: $title}
        --max-time 10sec
        $url
        $message)
    if $response.status < 400 { return {status: success} }
    let reason = if $response.status == 429 {
        'ntfy rate limit reached (HTTP 429).'
    } else {
        $"ntfy rejected the notification \(HTTP ($response.status)\)."
    }
    {
        status: warning
        reason: $reason
        diagnostics: $"provider=ntfy http_status=($response.status)"
    }
}

def notify-macos [title: string, message: string]: nothing -> record {
    let output = (^terminal-notifier
        -title $title
        -message $message
        -sound default)
    if ($output | is-not-empty) { log info $output }
    {status: success}
}

# Notify that an agent stopped unless its tmux pane is focused
def main []: nothing -> string {
    if (pane-focused) { return ({status: success} | to json --raw) }
    let title = pwd | path basename
    let message = $"@(sys host | get hostname)"
    let result = match $nu.os-info.name {
        'linux' => (notify-ntfy $title $message)
        'macos' => (notify-macos $title $message)
        $platform => {
            log error $"unsupported notification platform: ($platform)"
            exit 1
        }
    }
    $result | to json --raw
}
