#!/usr/bin/env nu

use std/log
use tab-status.nu

const HOOKS = path self | path dirname

def "main pi" []: nothing -> nothing {
    main
}

# Mark the agent tab as waiting and notify the user
def main []: nothing -> nothing {
    tab-status question
    let output = ^($HOOKS | path join notify)
    if ($output | is-not-empty) {
        log info $output
    }
}
