# ---------------- DOTENV
dotenv-setup:
  just sops-decrypt-dev
  just dotenv-setup-ports
  just dotenv-show

dotenv-kill-ports:
  sandbox bun run scripts/dotenv-kill-ports.ts

dotenv-setup-ports:
  sandbox bun run scripts/dotenv-setup-ports.ts

dotenv-show:
  sandbox bun run scripts/dotenv-show.ts

# ---------------- SOPS
sops-encrypt ENV:
  sops --encrypt --in-place .env.{{ENV}}.yaml

sops-edit ENV:
  sops .env.{{ENV}}.yaml

sops-decrypt-dev:
  sops --decrypt --output-type dotenv --output .env .env.dev.yaml

sops-fix ENV:
  sops --ignore-mac --rotate --in-place .env.{{ENV}}.yaml

sops-unset ENV KEY:
  sops unset .env.{{ENV}}.yaml '["{{KEY}}"]'

sops-set ENV KEY VALUE:
  sops set .env.{{ENV}}.yaml '["{{KEY}}"]' '"{{VALUE}}"'
  sops --ignore-mac --rotate --in-place .env.{{ENV}}.yaml

sops-set-secret ENV KEY:
  sandbox bun run scripts/sops-set-secret.ts {{ENV}} {{KEY}}

sops-set-password ENV KEY:
  #!/usr/bin/env nu
  let pass = (nix run nixpkgs#xkcdpass -- --delimiter=- --numwords=4)
  ^just --quiet sops-set {{ENV}} {{KEY}} $pass

sops-set-secret-most KEY:
  sandbox bun run scripts/sops-set-secret.ts dev pr prod {{KEY}}

sops-run-dev CMD:
  sops exec-env .env.dev.yaml '{{CMD}}'

sops-run-test CMD:
  sops exec-env .env.test.yaml '{{CMD}}'

sops-sync-check:
  sandbox bun run scripts/sops-sync-check.ts
