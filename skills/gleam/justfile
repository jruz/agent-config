default:
  just --list

check:
  just gleam-check

fix:
  just gleam-fix

run:
  just gleam-run

watch:
  just gleam-watch

# ──────────────────────────────────────── gleam

gleam-check:
  gleam format --check
  gleam build
  gleam test

gleam-fix:
  gleam format

gleam-build:
  gleam build

gleam-clean:
  rm -rf build

gleam-export:
  gleam export erlang-shipment

gleam-format:
  gleam format

gleam-format-check:
  gleam format --check

gleam-run:
  gleam run

gleam-test:
  gleam test

gleam-watch:
  watchexec --exts gleam --restart gleam run

# ──────────────────────────────────────── gleam-deps

gleam-deps:
  gleam deps download

gleam-deps-outdated:
  gleam deps list --outdated

gleam-deps-update:
  gleam deps update
