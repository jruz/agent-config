set dotenv-load := true

default:
  just --list

gleam-build:
  gleam build --warnings-as-errors

gleam-clean:
  rm -rf build

gleam-deps:
  gleam deps download

gleam-deps-outdated:
  gleam deps list --outdated

gleam-deps-update:
  gleam deps update

gleam-run:
  gleam run

gleam-test:
  gleam test

gleam-watch:
  watchexec --exts gleam --restart gleam build --warnings-as-errors
