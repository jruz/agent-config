# bin projects only
install:
    cargo install --path . --force

rust-build:
    cargo build --all-targets

rust-cargo-check:
    cargo check --all-targets

rust-check:
    just rust-cargo-check
    just rust-lint
    just rust-test

rust-outdated:
    cargo outdated

rust-test *FILTER='':
    cargo nextest run --no-tests=pass {{FILTER}}

rust-upgrade:
    cargo upgrade --incompatible
    cargo update

check:
    just rust-check
