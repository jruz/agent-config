rust-build:
    cargo build --all-targets

rust-check:
    just rust-lint
    just rust-test

rust-check-allow:
    #!/usr/bin/env nu
    let matches = (rg '#\[allow\(' src --type rust | complete)
    if $matches.exit_code == 0 {
        print $matches.stdout
        error make {msg: "ERROR: #[allow(...)] is banned - refactor code to satisfy the linter"}
    }

rust-check-unwrap:
    #!/usr/bin/env nu
    let matches = (rg '\.unwrap\(' src --type rust | complete)
    if $matches.exit_code == 0 {
        print $matches.stdout
        error make {msg: "ERROR: .unwrap() is banned - use explicit error handling (?, match, if let, etc.)"}
    }

rust-clippy *ARGS='':
    cargo clippy --all-targets {{ARGS}}

rust-clippy-fix *ARGS='':
    cargo clippy --fix --all-targets --allow-dirty {{ARGS}}

rust-fix:
    just rust-fmt-fix
    just rust-clippy-fix

rust-fmt *FILES='':
    cargo fmt --all -- --check {{FILES}}

rust-fmt-fix:
    cargo fmt --all

rust-lint:
    just rust-check-allow
    just rust-check-unwrap
    just rust-fmt
    just rust-clippy

rust-outdated:
    cargo outdated

rust-test *FILTER='':
    cargo nextest run {{FILTER}}

rust-upgrade:
    cargo upgrade --incompatible
    cargo update

check:
    just rust-check
