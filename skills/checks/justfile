# Gleam - gleam format/build
# Note: gleam check doesn't support --warnings-as-errors, must use gleam build
gleam-check:
    gleam build --warnings-as-errors
    gleam format --check

gleam-fix:
    gleam format

# JavaScript/TypeScript/JSON/CSS - Biome
js-check:
    biome check .
    biome format .

js-fix:
    biome check --fix .
    biome format --write .

# Markdown - markdownlint-cli2
md-check:
    markdownlint-cli2 '**/*.md'

md-fix:
    markdownlint-cli2 --fix '**/*.md'

# Rust - see rust skill for recipes

# Nushell - see nushell skill for recipes

# Nix - statix/deadnix/nixfmt
nix-check:
    fd \
        --extension nix \
        --exec nixfmt --check
    statix check .
    deadnix --fail .

nix-fix:
    fd \
        --extension nix \
        --exec nixfmt
    statix fix .
    deadnix --edit .

# Shell - shellcheck/shfmt
sh-check:
    fd \
        --extension sh \
        --exec shellcheck \
        --shell=bash
    fd \
        --extension sh \
        --exec shfmt --diff

sh-fix:
    fd \
        --extension sh \
        --exec shfmt --write

# YAML - yamllint
yaml-check:
    fd \
        --extension yaml \
        --extension yml \
        --hidden \
        --exec yamllint \
        --strict \
        --config-file .yamllint.yaml

# TOML - taplo
toml-check:
    fd \
        --extension toml \
        --exec taplo format --check

toml-fix:
    fd \
        --extension toml \
        --exec taplo format

# CSS - stylelint
css-check:
    bun stylelint "src/**/*.css"

css-fix:
    bun stylelint "src/**/*.css" --fix

# Lua - selene/stylua
lua-check:
    selene .
    stylua --check .

lua-fix:
    stylua .

# SQL - sqlx
sql-check:
    cargo sqlx prepare --check -- --all-targets

# CI - woodpecker-cli
woodpecker-check:
    woodpecker-cli lint \
        --strict \
        .woodpecker/

# Ansible - ansible-lint
ansible-check:
    ansible-lint \
        --strict \
        --profile safety

# Aggregate recipes (adapt based on project languages)
check:
    just js-check
    just rust-check
    just nix-check
    just sh-check
    just yaml-check
    just toml-check

fix:
    just js-fix
    just rust-fix
    just nix-fix
    just sh-fix
    just toml-fix
