# ---------------- PLAYWRIGHT
playwright-build:
  #!/usr/bin/env nu
  source {{justfile_directory()}}/scripts/load-test-env.nu
  ^just build

playwright *ARGS='':
  #!/usr/bin/env nu
  ^just playwright-build
  source {{justfile_directory()}}/scripts/load-test-env.nu
  ^npx playwright test {{ARGS}}

playwright-update-snapshots:
  #!/usr/bin/env nu
  ^just playwright-build
  source {{justfile_directory()}}/scripts/load-test-env.nu
  ^npx playwright test --update-snapshots
