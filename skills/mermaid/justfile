mermaid-check:
  #!/usr/bin/env nu
  glob specs/**/*.mmd | each { |f|
      print $"[(ansi blue)INFO(ansi reset)] Checking ($f)"
      ^mmdc --input $f --output /tmp/mermaid-check.svg
  }
  print $"[(ansi green)OK(ansi reset)] Mermaid diagrams are valid"

mermaid-preview:
    bun run scripts/mermaid-preview.ts
