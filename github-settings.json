{
  "repository": "jruz/agent-config",
  "settings": {
    "description": "Shared configuration for Pi, Claude Code, and Codex",
    "private": false,
    "allow_auto_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "allow_squash_merge": true,
    "archived": false,
    "default_branch": "main",
    "delete_branch_on_merge": true,
    "has_issues": true,
    "has_projects": false,
    "has_wiki": false,
    "is_template": false
  },
  "topics": {
    "names": ["pi", "claude-code", "codex", "agent-configuration", "dotfiles"]
  },
  "branch_protection": {
    "required_status_checks": null,
    "enforce_admins": true,
    "required_pull_request_reviews": null,
    "restrictions": null,
    "required_linear_history": true,
    "allow_force_pushes": true,
    "allow_deletions": false
  },
  "actions": { "enabled": false },
  "security": {
    "vulnerability-alerts": true,
    "automated-security-fixes": false
  },
  "labels": [
    { "name": "bugs", "color": "d73a4a" },
    { "name": "deps", "color": "0075ca" },
    { "name": "feat", "color": "2da44e" },
    { "name": "refa", "color": "a2eeef" },
    { "name": "tool", "color": "7057ff" }
  ]
}
